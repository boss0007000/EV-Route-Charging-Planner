{
  "name": "EVRoutePlanner",
  "version": "1.0.0",
  "private": true,
  "description": "EV Route & Charging Planner — plan your electric vehicle journey with smart charging stops",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "admin": "cd admin && npm start"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/slider": "^5.2.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@op-engineering/op-sqlite": "^18.2.5",
    "axios": "^1.6.5",
    "react": "19.2.3",
    "react-hook-form": "^7.50.1",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-maps": "^1.29.8",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-screens": "^4.28.0",
    "react-native-vector-icons": "^10.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|@react-navigation|react-native-maps|react-native-vector-icons|@op-engineering/op-sqlite|react-native-config|react-native-geolocation-service|react-native-safe-area-context|react-native-screens|react-native-linear-gradient)/)"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^react-native-config$": "<rootDir>/__mocks__/react-native-config.js",
      "^@op-engineering/op-sqlite$": "<rootDir>/__mocks__/@op-engineering/op-sqlite.js",
      "^react-native-maps$": "<rootDir>/__mocks__/react-native-maps.js",
      "^react-native-geolocation-service$": "<rootDir>/__mocks__/react-native-geolocation-service.js",
      "^@react-native-community/slider$": "<rootDir>/__mocks__/@react-native-community/slider.js"
    }
  }
}
