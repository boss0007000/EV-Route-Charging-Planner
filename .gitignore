*.swp
*.swo
*~
.#*

# Native build cache (CMake)
android/app/.cxx/

# Pre-rebuild broken iOS scaffolding, kept temporarily for reference only —
# safe to delete once the regenerated ios/ project is confirmed working
ios.OLD_BROKEN_unused/
ios-app.OLD_BROKEN_unused/

# Local Claude Code tooling state, not app code
.claude/

# Adobe Illustrator autosave/lock temp files
~ai-*.tmp
